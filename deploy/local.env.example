# Settings for deploy/local.sh. Copy to deploy/local.env (which git ignores) and fill in.
# It holds secrets, so keep it private: chmod 600 deploy/local.env
# Every line is optional; see deploy/README.md for what each one does.

# Public URL. Unset: https://<public-ip-with-dashes>.sslip.io/  |  "none": local/SSH tunnel only
#BUGSBOT_DOMAIN=bugsbot.example.com
# Skip public IP auto-detection
#PUBLIC_IP=203.0.113.7

# GitHub token for bugsbot (signed in to gh for the bugsbot user)
#BUGSBOT_GITHUB_TOKEN=github_pat_...
#ANTHROPIC_API_KEY=sk-ant-...
# Cursor (Cursor dashboard → Integrations → User API Keys), for Cursor runs and Cloud Agent workers
#CURSOR_API_KEY=...

# Web UI sign-in with GitHub
#BUGSBOT_OAUTH_CLIENT_ID=Ov23li...
#BUGSBOT_OAUTH_CLIENT_SECRET=...
#BUGSBOT_ALLOWED_USERS=Briggsby
#BUGSBOT_ALLOWED_ORGS=

# What to track (comma-separated; only ever added)
#BUGSBOT_REPOS=Briggsby/bugsbot
#BUGSBOT_LABELS=bugsbot
#BUGSBOT_SETTINGS_JSON='{"max_concurrent_agents": 1}'
